# Copy this file to .env.local and add your own project values.
# Supabase: https://supabase.com (Project Settings > API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Paystack public key (optional; for payment integration setup)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_TEST_KEY
